# Server
PORT=4000
NODE_ENV=production

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis (Upstash)
REDIS_URL=redis://default:password@host:port

# JWT
JWT_ACCESS_SECRET=your-super-secret-jwt-key-at-least-32-chars

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=noreply@kassahun.com

# Frontend URL (for CORS and QR codes)
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app

# Sentry (optional)
SENTRY_DSN=your-sentry-dsn

# MFA Encryption Key (AES-256-GCM, 64 hex chars or 44 base64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=your-64-char-hex-key-for-aes-256-gcm-encryption
